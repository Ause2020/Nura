# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# Service role — provisionamiento, invitaciones, cron (obligatorio en producción)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Admin de plataforma Nura — acceso a /admin/acceso (coma-separado)
NURA_ADMIN_EMAILS=admin@tuempresa.com

# Email (Resend) — alertas críticas y notificaciones
RESEND_API_KEY=re_xxxxxxxx

# App URL pública — links en emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron de notificaciones (también genera el análisis diario de IA)
CRON_SECRET=genera_un_secreto_largo_aqui

# IA (Claude) — análisis NC, briefing diario en /analisis
ANTHROPIC_API_KEY=sk-ant-...

# Rate limiting (Postgres distribuido). Valores = defaults de producción.
# RATE_LIMIT_DISABLED=true
# RATE_LIMIT_PEPPER=genera_un_secreto_largo_aqui
# RATE_LIMIT_PUBLIC_PAGE_MAX=60
# RATE_LIMIT_PUBLIC_PAGE_WINDOW_SEC=60
# RATE_LIMIT_PUBLIC_FORM_MAX=20
# RATE_LIMIT_PUBLIC_FORM_WINDOW_SEC=60
# RATE_LIMIT_UPLOAD_MAX=5
# RATE_LIMIT_UPLOAD_WINDOW_SEC=600
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_AUTH_WINDOW_SEC=60
# RATE_LIMIT_AI_MAX=10
# RATE_LIMIT_AI_WINDOW_SEC=60
# RATE_LIMIT_AI_IP_MAX=60
# RATE_LIMIT_AI_IP_WINDOW_SEC=60
# RATE_LIMIT_ADMIN_MAX=60
# RATE_LIMIT_ADMIN_WINDOW_SEC=60
# RATE_LIMIT_AUTHENTICATED_MAX=120
# RATE_LIMIT_AUTHENTICATED_WINDOW_SEC=60
# RATE_LIMIT_WRITE_MAX=30
# RATE_LIMIT_WRITE_WINDOW_SEC=60
# RATE_LIMIT_EMAIL_MAX=10
# RATE_LIMIT_EMAIL_WINDOW_SEC=600
# RATE_LIMIT_HEAVY_MAX=10
# RATE_LIMIT_HEAVY_WINDOW_SEC=60
# RATE_LIMIT_CRON_MAX=5
# RATE_LIMIT_CRON_WINDOW_SEC=60
# RATE_LIMIT_UNAUTH_PROBE_MAX=20
