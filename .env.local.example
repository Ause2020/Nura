# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# Service role — provisionamiento, invitaciones, cron (obligatorio en producción)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Admin de plataforma Nura — acceso a /admin/acceso (coma-separado)
NURA_ADMIN_EMAILS=admin@tuempresa.com

# Email (Resend) — alertas críticas y notificaciones
RESEND_API_KEY=re_xxxxxxxx

# App URL pública — links en emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron de notificaciones (también genera el análisis diario de IA)
CRON_SECRET=genera_un_secreto_largo_aqui

# IA (Claude) — análisis NC, briefing diario en /analisis
ANTHROPIC_API_KEY=sk-ant-...
